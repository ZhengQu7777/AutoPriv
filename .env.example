# Required for LLM-driven agents.
AUTOPRIV_LLM_API_KEY=
AUTOPRIV_LLM_BASE_URL=
AUTOPRIV_LLM_MODEL=
AUTOPRIV_LLM_TIMEOUT_S=30

# Prober policy: startup probes once, then long-running executor should re-probe with this interval.
AUTOPRIV_PROBE_INTERVAL_S=300

# Executor policy for SecretFlow backend.
AUTOPRIV_SECRETFLOW_ENV=sf
AUTOPRIV_SECRETFLOW_PSI_SCRIPT=examples/psi/secretflow_psi_demo.py
